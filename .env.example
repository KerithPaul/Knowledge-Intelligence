# Secrets only. Model names, sizes, and thresholds live in configs/settings.yaml.
GROQ_API_KEY=
TAVILY_API_KEY=
# Langfuse stays off until langfuse.enabled is true in configs/settings.yaml
# (or LANGFUSE__ENABLED=true). Both keys are required. The base URL is not a
# secret and lives in that YAML file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
